FROM runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel-ubuntu22.04

WORKDIR /app

# Copy requirements and handler
COPY requirements.txt handler.py ./

# Upgrade pip and install PyTorch 2.6.0 with CPU fallback
RUN pip install --upgrade pip && \
    pip install torch==2.6.0 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118 || \
    pip install torch==2.6.0 torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# Install other dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV TRANSFORMERS_CACHE=/runpod-volume
ENV HF_HOME=/runpod-volume

CMD ["python", "handler.py"]
